# Optional public backend URL for a separately hosted frontend.
# Leave blank when using the Vite proxy or the Node server serving dist.
# Never put MAILGUN_API_KEY or other secrets in VITE_* variables.
VITE_CONTACT_API_BASE=
# Optional public API origin when the AI backend is hosted separately.
# Falls back to VITE_CONTACT_API_BASE, then the Vite /api proxy. NOT an API key.
VITE_ASSISTANT_API_BASE=

# Server-only AI credential belongs in contact-backend/.env, never in VITE_*:
# COHERE_API_KEY=
# COHERE_MODEL=command-a-03-2025
# COHERE_VISION_MODEL=command-a-vision-07-2025
