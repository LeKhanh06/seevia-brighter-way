{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@seevia/i18n",
    "paths": { "@seevia/i18n/*": ["./src/i18n/*"] },
    "strict": true
  },
  "include": [
    "src",
    "HomePage",
    "ProductPage",
    "TechnologyPage",
    "AboutPage",
    "CommunityPage",
    "NewsPage",
    "PartnerPage",
    "ContactPage",
    "PolicyPage"
  ]
}
