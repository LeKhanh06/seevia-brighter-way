MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_REGION=us
MAIL_FROM=
MAIL_TO=your-email@example.com
PORT=3001
HOST=127.0.0.1
ALLOWED_ORIGIN=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5176,http://localhost:5176
TRUST_PROXY=false

# Cohere AI support. Keep this key in this server-side environment file only.
COHERE_API_KEY=
COHERE_MODEL=command-a-03-2025
# Optional shared Redis REST limiter. Required on Vercel/serverless.
ASSISTANT_REDIS_REST_URL=
ASSISTANT_REDIS_REST_TOKEN=
# Optional stable private salt for pseudonymous rate-limit keys.
ASSISTANT_RATE_SALT=
