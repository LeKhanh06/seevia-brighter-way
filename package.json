{
  "name": "seevia",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "server": "node --env-file-if-exists=contact-backend/.env contact-backend/server.mjs",
    "test:mail": "node --test contact-backend/*.test.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src HomePage ProductPage TechnologyPage AboutPage CommunityPage NewsPage PartnerPage ContactPage PolicyPage index.html vite.config.ts tsconfig.json package.json README.md"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.0.0"
  }
}
