{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/contact.mjs": { "maxDuration": 30 },
    "api/assistant.mjs": { "maxDuration": 30 }
  },
  "rewrites": [
    {
      "source": "/api/assistant/status",
      "destination": "/api/assistant?assistant_status=1"
    },
    {
      "source": "/api/contact/status",
      "destination": "/api/contact?contact_status=1"
    },
    { "source": "/mo-phong", "destination": "/mo-phong/index.html" },
    { "source": "/mo-phong/", "destination": "/mo-phong/index.html" },
    { "source": "/((?!api/|mo-phong/).*)", "destination": "/index.html" }
  ]
}
